{
  "name": "rsstag_front",
  "version": "0.1.0",
  "description": "rsstag frontend app",
  "main": "app.js",
  "type": "module",
  "dependencies": {
    "d3": "^7.9.0",
    "sunburst-chart": "^1.19.2"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "c8": "^10.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "watch": "vite build --mode development --watch",
    "clean": "rm -f bundle.js bundle.js.map",
    "lint": "eslint components/context-filter-bar.js components/post-item.js storages/context-filter-storage.js storages/posts-storage.js libs/rsstag_utils.js libs/source-grouping.js libs/post-canvas.js libs/post-canvas-viewport.js libs/post-canvas-summaries.js post-canvas.js topics-list.js provider-feeds.js tag-feeds.js post-grouped-snippets.js vite.config.mjs eslint.config.cjs vitest.config.cjs test/**/*.js --max-warnings=0",
    "lint:all": "eslint \"**/*.{js,jsx,cjs,mjs}\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"{apps,components,storages,libs}/**/*.{js,jsx}\" \"*.{js,json,md,cjs,mjs}\" \"test/**/*.js\" \"../css/style.css\"",
    "format:check": "prettier --check \"{apps,components,storages,libs}/**/*.{js,jsx}\" \"*.{js,json,md,cjs,mjs}\" \"test/**/*.js\" \"../css/style.css\"",
    "test": "sh -c 'node --loader ./test/es-module-loader.mjs --test $(grep -rL \"from '\\''vitest'\\''\" ./test --include=\"*.test.js\" --include=\"*.spec.js\" | sort)'",
    "test:watch": "sh -c 'node --loader ./test/es-module-loader.mjs --test --watch $(grep -rL \"from '\\''vitest'\\''\" ./test --include=\"*.test.js\" --include=\"*.spec.js\" | sort)'",
    "test:dom": "vitest run --config vitest.config.cjs",
    "check": "npm run lint && npm run format:check && npm run build:dev && npm run test && npm run test:dom",
    "quality": "./frontend-quality.sh"
  },
  "keywords": [
    "rss"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=9.0.0"
  }
}
